/* Zephyr openamp_rsc_table örneğindeki DK overlay'i ile aynı: RPMsg paylaşımlı belleği ve IPCC posta kutusu.
   0x81200000, 1 MiB: Linux'un remoteproc için ayırdığı DDR bölgesiyle örtüşmeli (README risk Z-R2). */
/ {
	chosen {
		zephyr,ipc_shm = &ipc_shmem;
		zephyr,ipc = &mailbox;
	};

	ipc_shmem: memory1@81200000 {
		compatible = "mmio-sram";
		reg = <0x81200000 DT_SIZE_M(1)>;
	};
};
